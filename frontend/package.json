{
    "name": "@mutablelogic/go-server",
    "version": "0.0.0",
    "description": "TypeScript clients of go-server's APIs, such as its configuration, and the broadcaster's stream of changes",
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mutablelogic/go-server.git",
        "directory": "frontend"
    },
    "exports": {
        "./api": {
            "types": "./dist/api/index.d.ts",
            "import": "./dist/api/index.js"
        },
        "./broadcaster": {
            "types": "./dist/broadcaster/index.d.ts",
            "import": "./dist/broadcaster/index.js"
        },
        "./config": {
            "types": "./dist/config/index.d.ts",
            "import": "./dist/config/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc -p tsconfig.json",
        "test": "node --test 'test/**/*.test.ts'"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.9.0"
    }
}
